{
  "name": "nexus-response-intelligence",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx tools/dev.ts",
    "db:up": "docker compose -f infra/docker-compose.yml up -d --wait",
    "db:migrate": "tsx tools/database.ts migrate",
    "db:seed": "tsx tools/database.ts seed",
    "setup": "tsx tools/bootstrap.ts",
    "typecheck": "tsc --noEmit && pnpm --filter @nexus/cad-web exec tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx tools/test-database.ts && vitest run",
    "test:integration": "tsx tools/test-database.ts && vitest run tests/integration.test.ts",
    "test:e2e": "playwright test",
    "test:performance": "tsx tests/performance/benchmark.ts",
    "build": "pnpm --filter @nexus/cad-web build && pnpm --filter @nexus/citizen-pwa build && pnpm --filter @nexus/responder-pwa build",
    "format": "prettier --write .",
    "test:k6": "tsx tools/k6.ts",
    "start": "tsx tools/dev.ts --production",
    "test:db-restart": "tsx tests/fault/database-restart.ts",
    "audit:keygen": "tsx tools/audit-keygen.ts",
    "audit:verify": "node tools/verify-checkpoint.mjs",
    "maps:download": "tsx tools/maps.ts download",
    "maps:prepare": "tsx tools/maps.ts prepare",
    "maps:up": "docker compose -f infra/docker-compose.yml --profile routing up -d routing",
    "test:routing": "tsx tests/routing/osrm-engine.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@tanstack/react-query": "^5.90.0",
    "cookie": "^1.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "i18next": "^25.6.0",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^5.10.0",
    "next": "^16.0.0",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.2.0",
    "react-router-dom": "^7.9.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^3.25.0",
    "zod-to-json-schema": "^3.25.0",
    "@fontsource/inter": "^5.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@types/cookie": "^0.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.0",
    "@types/pdfkit": "^0.17.3",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.2.0",
    "vitest": "^3.2.0",
    "prettier": "^3.6.0",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@tailwindcss/vite": "^4.1.0",
    "@axe-core/playwright": "^4.11.0"
  },
  "type": "module"
}
