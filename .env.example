# Local fictional research simulator. Never reuse demo passwords elsewhere.
DATABASE_URL=postgresql://nexus:nexus-local-only@127.0.0.1:55432/nexus
POSTGRES_PASSWORD=nexus-local-only
DEMO_MODE=true
PORT=4000
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174
DEMO_PASSWORD=Nexus-Demo-2026!

# Local Ed25519 signing: setup generates private files here; never commit .nexus.
AUDIT_SIGNING_CONFIG=.nexus/keys/signing.json
AUDIT_TRUSTED_KEYS_FILE=.nexus/keys/trusted-public-keys.json
# Optional public road data and self-hosted OSRM. Empty provider means ETA unavailable.
OSM_ROADS_FILE=.nexus/maps/osogbo-roads.geojson
MAP_STYLE_URL=
OSRM_BASE_URL=
ROUTING_DATA_VERSION=
