{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node", "vite/client"]
  },
  "include": [
    "apps/api/**/*.ts",
    "apps/worker/**/*.ts",
    "apps/citizen-pwa/**/*.ts*",
    "apps/responder-pwa/**/*.ts*",
    "packages/**/*.ts*",
    "tools/**/*.ts",
    "tests/**/*.ts",
    "*.ts"
  ],
  "exclude": ["node_modules", "**/dist/**", "**/.next/**"]
}
